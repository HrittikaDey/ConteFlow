{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "bun install",
    "nixpacksPlan": {
      "providers": ["bun"],
      "variables": {
        "NODE_VERSION": "20"
      }
    }
  },
  "deploy": {
    "startCommand": "bun ./src/server.ts",
    "restartPolicyType": "ON_FAILURE"
  }
}